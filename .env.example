NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
PUBLIC_APP_URL=http://127.0.0.1:3000

# Production: set DATABASE_URL to use PostgreSQL instead of local SQLite.
# Example: postgresql://postgres.xxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_SSL=true

# Local fallback when DATABASE_URL is empty.
DATABASE_PATH=./data/storyline.sqlite

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_SECRET=replace-with-long-random-secret

# Optional SMTP/reset mail integration. In development reset links are returned only to the requester.
MAIL_FROM=Storyline <no-reply@example.com>

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback
